{
  "name": "@agromind/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc --noEmit && esbuild src/server.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sinclair/typebox": "0.34.52",
    "argon2": "0.45.1",
    "csv-parse": "^7.0.3",
    "dotenv": "18.0.8",
    "exceljs": "^4.4.0",
    "fastify": "5.12.7",
    "nodemailer": "10.2.0",
    "pg": "8.23.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
